# ==========================================
# CivicGraph Audit — Environment Configuration
# ==========================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Supabase / Database Credentials (Server only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicgraph_audit
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Supported: gemini, mock, template_fallback
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Model / Engine Configuration
ENABLE_UNSUPERVISED_ML=true
THRESHOLD_PROXIMITY_PCT=0.05
STRICT_COLLUSION_MARGIN=0.015
